# Runtime and trace
# Docker Compose also accepts RABBITMQ_USER and RABBITMQ_PASSWORD from the
# gitignored .env file. Its built-in values are for local development only.
COLLISION_MONITOR_TICK_INTERVAL_SECONDS=1.0
COLLISION_MONITOR_STALE_TIMEOUT_SECONDS=3.0
COLLISION_MONITOR_PUBLICATION_MAXIMUM_ATTEMPTS=3
COLLISION_MONITOR_PUBLICATION_RETRY_DELAY_SECONDS=0.05
COLLISION_MONITOR_TRACE_DETAILED_GEOMETRY=false
COLLISION_MONITOR_LOG_LEVEL=INFO
COLLISION_MONITOR_LOG_FORMAT=json

# RabbitMQ
# This is a deliberately non-secret local-development credential. Override it
# in an ignored .env file for any shared environment.
COLLISION_MONITOR_RABBITMQ_URL=amqp://collision_monitor:local-development-only@localhost/
COLLISION_MONITOR_RABBITMQ_EXCHANGE_NAME=collision_monitor
COLLISION_MONITOR_RABBITMQ_STATE_QUEUE=collision_monitor.robot_states
COLLISION_MONITOR_RABBITMQ_STATE_ROUTING_KEY=collision_monitor.state
COLLISION_MONITOR_RABBITMQ_ACTION_QUEUE_PREFIX=collision_monitor.robot_actions.
COLLISION_MONITOR_RABBITMQ_PREFETCH_COUNT=1
COLLISION_MONITOR_RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10.0
COLLISION_MONITOR_HEALTHCHECK_TIMEOUT_SECONDS=2.0
COLLISION_MONITOR_RABBITMQ_RECONNECT_INITIAL_DELAY_SECONDS=1.0
COLLISION_MONITOR_RABBITMQ_RECONNECT_MAX_DELAY_SECONDS=30.0

# Geometry
COLLISION_MONITOR_ROBOT_WIDTH_METRES=0.630
COLLISION_MONITOR_ROBOT_LENGTH_METRES=1.430
COLLISION_MONITOR_SAFETY_MARGIN_METRES=0.050
COLLISION_MONITOR_POSE_TOLERANCE=0.000001

# Optimisation and fallback
COLLISION_MONITOR_CP_SAT_TIME_LIMIT_SECONDS=0.050
COLLISION_MONITOR_CP_SAT_RANDOM_SEED=0
COLLISION_MONITOR_CP_SAT_LOG_SEARCH_PROGRESS=false
COLLISION_MONITOR_MAXIMUM_EXACT_COMPONENT_SIZE=20
COLLISION_MONITOR_HEURISTIC_MAXIMUM_REPAIR_CANDIDATES=20

# Grants and fairness
COLLISION_MONITOR_GRANT_MINIMUM_HOLD_TICKS=2
COLLISION_MONITOR_GRANT_MAXIMUM_HOLD_TICKS=10
COLLISION_MONITOR_GRANT_CLEARANCE_RELEASE_TICKS=2

# Priority
COLLISION_MONITOR_PRIORITY_BASE_PROGRESS_VALUE=10
COLLISION_MONITOR_PRIORITY_LOADED_BONUS=20
COLLISION_MONITOR_PRIORITY_DEADLINE_URGENCY_MAXIMUM=100
COLLISION_MONITOR_PRIORITY_DEADLINE_HORIZON_MS=300000
COLLISION_MONITOR_PRIORITY_LOW_BATTERY_THRESHOLD=20.0
COLLISION_MONITOR_PRIORITY_LOW_BATTERY_URGENCY_BONUS=30
COLLISION_MONITOR_PRIORITY_WAITING_AGE_BONUS_PER_TICK=5
COLLISION_MONITOR_PRIORITY_WAITING_AGE_CAP_TICKS=20
COLLISION_MONITOR_PRIORITY_ACTIVE_GRANT_CONTINUATION_BONUS=50
COLLISION_MONITOR_PRIORITY_CLEARANCE_BONUS_PER_CONFLICT=25
